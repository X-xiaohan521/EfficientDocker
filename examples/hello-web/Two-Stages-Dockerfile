# ===== Stage 1: Build =====
FROM debian:latest AS build

WORKDIR /build

# prepare go env
RUN apt update
RUN apt install -y golang

# build binary
COPY ./hello-web.go .
RUN go build -o ./hello-web ./hello-web.go

# ===== Stage 2: Run =====
FROM alpine:latest

WORKDIR /srv

COPY --from=build /build/hello-web hello-web

EXPOSE 8080
CMD ["/srv/hello-web"]